# Copy to .env for local development. Never commit .env.
# In production these are set in the Vercel project settings.

# development | production
APP_ENV=development

# Long random string that signs the household cookie:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# data.gov.in key for CPCB's real-time air quality (Generate API Key on the dataset page)
DATA_GOV_API_KEY=

# Groq console key (first model in the chain)
GROQ_API_KEY=

# Google AI Studio key (second and third models in the chain)
GEMINI_API_KEY=
